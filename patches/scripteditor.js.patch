+  // OpenScript: export through the local server (pdfserver/exporters.py).
+  exportScriptViaServer: function exportScriptViaServer (file, kind) {
+    ensureExtension(file, kind);
+    var Ci = Components.interfaces;
+    var Cc = Components.classes;
+    try {
+      var doc = this.editor.contentDocument;
+      var str = new XMLSerializer().serializeToString(doc);
+
+      var conv = Cc["@mozilla.org/intl/scriptableunicodeconverter"]
+        .createInstance(Ci.nsIScriptableUnicodeConverter);
+      conv.charset = "UTF-8";
+      var bytes = conv.ConvertFromUnicode(str) + conv.Finish();
+      var stream = Cc["@mozilla.org/io/string-input-stream;1"]
+        .createInstance(Ci.nsIStringInputStream);
+      stream.setData(bytes, bytes.length);
+
+      var size = "USLetter";
+      try {
+        if (this.scriptConfig && this.scriptConfig.size)
+          size = this.scriptConfig.size;
+      }
+      catch (ex) {}
+
+      var url = "http://127.0.0.1:47890/export/" + kind
+        + "?mode=" + encodeURIComponent(this.mode)
+        + "&size=" + encodeURIComponent(size)
+        + "&token=" + encodeURIComponent(openscriptToken());
+      var ios = getIOService();
+      var channel = ios.newChannelFromURI(ios.newURI(url, null, null));
+      channel.QueryInterface(Ci.nsIUploadChannel)
+        .setUploadStream(stream, "text/html; charset=UTF-8", -1);
+      channel = channel.QueryInterface(Ci.nsIHttpChannel);
+      channel.requestMethod = "POST";
+
+      var tmpfile = getTempDir();
+      tmpfile.append("cxexport-" + new Date().getTime() + "." + kind);
+
+      var listener = {
+        channel: channel,
+        dest: file,
+        QueryInterface: function (id) {
+          if (id.equals(Ci.nsIDownloadObserver) || id.equals(Ci.nsISupports))
+            return this;
+          throw Components.results.NS_ERROR_NOT_IMPLEMENTED;
+        },
+        onDownloadComplete: function (downloader, request, context,
+                                      status, result) {
+          var ok = false;
+          try {
+            ok = (status == Components.results.NS_OK
+                  && this.channel.requestSucceeded);
+          }
+          catch (ex) {}
+          if (! ok) {
+            try { if (result && result.exists()) result.remove(false); }
+            catch (ex) {}
+            window.alert(osText(
+              "No se pudo exportar el guion.\n\nAbre OpenScript con su "
+              + "lanzador (que arranca el servidor de exportación local) y "
+              + "revisa el registro openscript-server.log en la carpeta temporal.",
+              "The script could not be exported.\n\nStart OpenScript with its "
+              + "launcher (it starts the local export server) and check "
+              + "openscript-server.log in the temporary folder."));
+            return;
+          }
+          try {
+            if (this.dest.exists()) this.dest.remove(false);
+            result.moveTo(this.dest.parent, this.dest.leafName);
+          }
+          catch (ex) {
+            window.alert(osText("No se pudo guardar el archivo:\n",
+                                "The file could not be saved:\n") + ex);
+          }
+        }
+      };
+
+      var downloader = getDownloader();
+      downloader.init(listener, tmpfile);
+      channel.asyncOpen(downloader, null);
+    }
+    catch (ex) {
+      dump("*** exportScriptViaServer: " + ex + "\n");
+      window.alert(osText("No se pudo exportar el guion:\n",
+                          "The script could not be exported:\n") + ex);
+    }
+  },
+
