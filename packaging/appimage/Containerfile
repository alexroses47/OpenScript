# Build environment for the OpenScript AppImage (used by ./build.sh when the
# host is not Ubuntu 22.04). Ubuntu 22.04 keeps the AppImage compatible with
# any distribution that has glibc 2.35 or newer.
FROM docker.io/library/ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils p7zip-full file gcc make libc6-dev \
      python3 python3-pip python3-venv \
      libgtk2.0-0 gnome-themes-extra libxt6 \
      libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b fonts-liberation \
    && rm -rf /var/lib/apt/lists/*
COPY server/requirements.txt packaging/requirements-build.txt /tmp/
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements.txt -r /tmp/requirements-build.txt
WORKDIR /src
